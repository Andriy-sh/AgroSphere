{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "paths": {
            "react": ["./node_modules/@types/react"],
            "@agrosphere/shared": ["../../dist/libs/shared/src/index.d.ts"],
            "@agrosphere/shared/*": ["../../dist/libs/shared/src/*"]
        },
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,

        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "types": ["node"],

        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*.js",
        "src/**/*.jsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "references": [
        {
            "path": "../../libs/shared"
        },
        {
            "path": "./tsconfig.node.json"
        }
    ]
}
