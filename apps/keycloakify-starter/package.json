{
    "name": "keycloakify-starter",
    "version": "0.0.0",
    "description": "Starter for Keycloakify 11",
    "repository": {
        "type": "git",
        "url": "git://github.com/codegouvfr/keycloakify-starter.git"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "build-keycloak-theme": "npm run build && keycloakify build",
        "build-keycloakify-starter": "npm run build && keycloakify build",
        "storybook": "storybook dev -p 6006",
        "format": "prettier . --write",
        "build-keycloak": "nx build keycloakify-starter && keycloakify build -p apps/keycloakify-starter",
        "keycloakify-starter-storybook": "npx storybook dev -p 6006 -c apps/keycloakify-starter/.storybook",
        "start-keycloak": "keycloakify start-keycloak"
    },
    "license": "MIT",
    "keywords": [],
    "dependencies": {
        "@agrosphere/shared": "*",
        "@radix-ui/react-slot": "^1.2.3",
        "@tailwindcss/vite": "^4.1.11",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "keycloakify": "^11.8.42",
        "material-symbols": "^0.31.9",
        "react": "19.0.0",
        "react-dom": "19.0.0",
        "tailwind-merge": "^3.3.1",
        "tailwindcss": "^4.1.11",
        "zod": "^3.25.71"
    },
    "devDependencies": {
        "@eslint/js": "^9.15.0",
        "@storybook/react": "^8.6.14",
        "@storybook/react-vite": "^8.6.14",
        "@tailwindcss/postcss": "^4.1.11",
        "@types/react": "19.0.0",
        "@types/react-dom": "19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.15.0",
        "@typescript-eslint/parser": "^8.15.0",
        "@vitejs/plugin-react": "^4.2.1",
        "eslint": "^9.15.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.2",
        "eslint-plugin-react-hooks": "^5.0.0",
        "eslint-plugin-react-refresh": "^0.4.14",
        "eslint-plugin-storybook": "^0.11.1",
        "globals": "^15.12.0",
        "prettier": "3.3.1",
        "storybook": "^8.6.14",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.15.0",
        "vite": "^5.0.8"
    },
    "engines": {
        "node": "^18.0.0 || >=20.0.0"
    }
}
