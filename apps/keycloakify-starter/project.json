{
    "name": "keycloakify-starter",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/keycloakify-starter/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/keycloakify-starter"],
            "defaultConfiguration": "production",
            "options": {
                "command": "vite build",
                "cwd": "apps/keycloakify-starter"
            },
            "configurations": {
                "development": {
                    "mode": "development"
                },
                "production": {
                    "mode": "production"
                }
            }
        },
        "serve": {
            "executor": "@nx/vite:dev-server",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "keycloakify-starter:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "keycloakify-starter:build:development",
                    "hmr": true
                },
                "production": {
                    "buildTarget": "keycloakify-starter:build:production",
                    "hmr": false
                }
            }
        },
        "preview": {
            "executor": "@nx/vite:preview-server",
            "defaultConfiguration": "development",
            "options": {
                "buildTarget": "keycloakify-starter:build"
            },
            "configurations": {
                "development": {
                    "buildTarget": "keycloakify-starter:build:development"
                },
                "production": {
                    "buildTarget": "keycloakify-starter:build:production"
                }
            }
        },
        "test": {
            "executor": "@nx/vite:test",
            "outputs": ["{options.reportsDirectory}"],
            "options": {
                "reportsDirectory": "../../coverage/apps/keycloakify-starter"
            }
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "storybook": {
            "executor": "@nx/storybook:storybook",
            "options": {
                "port": 6006,
                "configDir": "apps/keycloakify-starter/.storybook"
            },
            "configurations": {
                "ci": {
                    "quiet": true
                }
            }
        },
        "build-storybook": {
            "executor": "@nx/storybook:build",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/storybook/keycloakify-starter",
                "outputDir": "dist/storybook/keycloakify-starter",
                "configDir": "apps/keycloakify-starter/.storybook"
            }
        }
    },
    "tags": []
}
